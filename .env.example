# ─── Главный бот-конструктор ───────────────────────────────────────────
# Токен от @BotFather для бота-конструктора
BUILDER_BOT_TOKEN=

# ─── Публичный адрес ───────────────────────────────────────────────────
# HTTPS-адрес, по которому доступен nginx фронтенда (домен или туннель cloudflared).
# Через него идут Mini App, /api, /webhook и /media. Без слэша в конце.
PUBLIC_URL=https://your-domain.example.com

# ─── Секреты ───────────────────────────────────────────────────────────
# Ключ шифрования токенов ботов. Сгенерировать:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# ВНИМАНИЕ: если потерять или сменить ключ, сохранённые токены станут нечитаемыми.
FERNET_KEY=

# Секрет для подписи вебхуков (заголовок X-Telegram-Bot-Api-Secret-Token). Сгенерировать:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
WEBHOOK_SECRET=

# ─── PostgreSQL ────────────────────────────────────────────────────────
POSTGRES_USER=shop
POSTGRES_PASSWORD=change-me
POSTGRES_DB=shop

# ─── Прочее ────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
# Порт, на котором nginx фронтенда слушает на хосте (туда направляется туннель)
HTTP_PORT=8080
